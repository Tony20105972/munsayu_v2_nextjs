{
  "name": "munsayu-v2-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=e2e",
    "e2e:smoke": "playwright test --project=e2e",
    "db:start": "pg_ctl -D .tmp/pgdata -l .tmp/pg.log -o \"-p 55433\" start",
    "db:stop": "pg_ctl -D .tmp/pgdata stop",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "e2e:visual": "playwright test --project=visual-1440 --project=visual-390"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
