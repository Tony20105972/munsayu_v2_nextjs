{
  "name": "munsayu-v2-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:unit:changed",
    "test:unit:changed": "vitest run --project unit --changed --passWithNoTests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:feature": "vitest run --project integration",
    "e2e": "playwright test --project=e2e",
    "e2e:smoke": "playwright test --project=e2e",
    "e2e:visual": "playwright test --project=visual-1440 --project=visual-390",
    "e2e:visual:page": "playwright test --project=visual-1440 --project=visual-390 -g",
    "verify:all": "npm run check:assets && npm run typecheck && npm run lint && npm run test && npm run db:seed && npm run e2e && npm run e2e:visual",
    "db:start": "pg_ctl -D .tmp/pgdata -l .tmp/pg.log -o \"-p 55433\" start",
    "db:stop": "pg_ctl -D .tmp/pgdata stop",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:unlock": "tsx --conditions=react-server scripts/unlock-login.ts",
    "postinstall": "prisma generate",
    "check:assets": "node scripts/check-public-assets.mjs",
    "import:notices": "node scripts/import-legacy-notices.mjs",
    "build:media-registry": "tsx scripts/build-legacy-media-registry.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server prisma/seed.ts"
  }
}
