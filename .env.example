# 로컬 개발용 PostgreSQL 연결 문자열 (ASM-008, ASM-012)
DATABASE_URL=
# 연결 풀을 거치지 않는 **직접 접속** 주소. 마이그레이션에만 쓴다.
# Neon·Supabase 같은 관리형 DB 는 이 주소를 따로 준다. 비우면 DATABASE_URL 을 쓴다.
DATABASE_URL_UNPOOLED=
# 통합 테스트용 PostgreSQL 연결 문자열
DATABASE_URL_TEST=
# 세션·토큰 서명용 비밀값
AUTH_SECRET=
# 메일 본문의 링크 기준 주소 (비밀번호 재설정 링크 등)
APP_BASE_URL=
# 메일 어댑터 선택: console | resend (기본 console, ASM-010)
MAIL_ADAPTER=
# 메일 발신 주소
MAIL_FROM=
# Resend 어댑터를 쓸 때만 필요
RESEND_API_KEY=
# 알림(문자) 어댑터: 현재 console만 (D4)
NOTIFY_ADAPTER=
NOTIFY_PROVIDER_API_KEY=
# 방문 통계 도구 ID (ASM-004). 비어 있으면 스크립트를 넣지 않는다
ANALYTICS_PROVIDER_ID=
# 이미지·파일 저장소 어댑터: local | vercel-blob (ASM-008, ADR-008)
# 비우면 local. 운영·스테이징은 vercel-blob. 모르는 이름이면 바로 멈춘다.
STORAGE_ADAPTER=
# local 어댑터가 파일을 둘 폴더. 비우면 `.storage` 를 쓴다.
# `<STORAGE_ROOT>/private` 에는 강사 이력서가 들어가며 공개 주소를 만들지 않는다. (AD-011)
STORAGE_ROOT=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# 관리자용 파기 경로(`POST /api/admin/privacy/purge`)를 세션 없이 부를 때 쓰는 비밀값.
# `x-purge-secret` 헤더로 보낸다. 손으로 한 번 돌릴 때만 쓰고, 정기 실행은 아래 CRON_SECRET 이다. (AD-013)
PRIVACY_PURGE_SECRET=
# seed 전용 가짜 계정 비밀번호 (운영에서는 쓰지 않는다)
SEED_ADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=

# --- Vercel Blob 저장소 (STORAGE_ADAPTER=vercel-blob 일 때, Phase 7) ---
# Vercel 에서 Blob 저장소를 프로젝트에 연결하면 아래 두 개가 자동으로 들어온다.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# 공개 사진 주소의 기준(`https://<store>.public.blob.vercel-storage.com`).
# 비워 둬도 사진 올리기·보기는 된다. 올릴 때 저장소가 돌려준 주소를 그대로 쓰기 때문이다.
# 저장한 키로 공개 주소를 **다시 만들어야** 하는 코드(`urlFor("public", ...)`)만 이 값을
# 쓰고, 비어 있으면 틀린 주소를 만들지 않고 멈춘다. 현재 그 코드를 부르는 곳은 없다.
BLOB_PUBLIC_BASE_URL=

# --- 예약 실행 (Phase 7, ASM-100) ---
# 하루 한 번 도는 파기 경로(`GET /api/cron/privacy-purge`)를 지키는 비밀값.
# Vercel 이 이 값으로 `Authorization: Bearer ...` 를 붙여 **자동으로** 보낸다.
# 비우면 그 경로는 아무도 통과하지 못한다(404). 위 PRIVACY_PURGE_SECRET 과 역할이 다르다:
#   PRIVACY_PURGE_SECRET = 사람이 손으로 한 번 돌릴 때 (POST, 헤더를 직접 넣음)
#   CRON_SECRET          = Vercel 예약 실행 (GET, Vercel 이 헤더를 붙임)
CRON_SECRET=

# --- 첫 관리자 계정 (scripts/bootstrap-admin.ts, Phase 7) ---
# 새 데이터베이스에 맨 처음 관리자 한 명을 만들 때만 쓴다. 평소에는 비워 둔다.
# BOOTSTRAP_ADMIN_PASSWORD 를 비우면 임시 비밀번호를 만들어 터미널에 한 번만 찍는다.
BOOTSTRAP_ADMIN_ID=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
