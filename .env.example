# 로컬 개발용 PostgreSQL 연결 문자열 (ASM-008, ASM-012)
DATABASE_URL=
# 통합 테스트용 PostgreSQL 연결 문자열
DATABASE_URL_TEST=
# 세션·토큰 서명용 비밀값
AUTH_SECRET=
# 메일 어댑터 선택: console | resend (기본 console, ASM-010)
MAIL_ADAPTER=
# 메일 발신 주소
MAIL_FROM=
# Resend 어댑터를 쓸 때만 필요
RESEND_API_KEY=
# 알림(문자) 어댑터: 현재 console만 (D4)
NOTIFY_ADAPTER=
NOTIFY_PROVIDER_API_KEY=
# 방문 통계 도구 ID (ASM-004). 비어 있으면 스크립트를 넣지 않는다
ANALYTICS_PROVIDER_ID=
# 이미지·파일 저장소 어댑터 (ASM-008)
STORAGE_ADAPTER=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# 보존 기간 경과 기록 파기의 예약 실행 경로 보호용 비밀값 (AD-013)
PRIVACY_PURGE_SECRET=
