// MUNSAYU V2 데이터 모델 (Phase 4).
// 연결 문자열은 Prisma 7 규칙에 따라 prisma.config.ts에만 둔다.
// 개인정보 컬럼에는 `/// PII` 주석을 붙인다. (BLUEPRINT 6장)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  WITHDRAWN
}

/// 회원 세션과 관리자 세션을 분리한다. 회원 세션으로는 관리자 요청을 통과시키지 않는다.
enum SessionScope {
  MEMBER
  ADMIN
}

enum IntakeStatus {
  OPEN
  CLOSED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ConsultationStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum NoticePublicationStatus {
  DRAFT
  PUBLISHED
}

/// src/lib/contracts/admin.ts 의 AUDIT_ACTIONS 와 같은 목록을 유지한다.
enum AuditAction {
  PII_VIEW
  CSV_EXPORT
  PII_PURGE
  PURGE_SCHEDULE_SET
  ADMIN_ACCOUNT_CREATE
  ADMIN_ACCOUNT_DELETE
  MEMBER_STATUS_CHANGE
  RETENTION_SETTING_CHANGE
  RESUME_DOWNLOAD
  NOTICE_IMPORT
  /// AD-015 이미지 올리기 · 바꾸기 · 지우기.
  MEDIA_UPLOAD
  MEDIA_UPDATE
  MEDIA_DELETE
  /// AD-015 기존 사이트 사진 숨기기·다시 보이기. 파일을 지울 수 없어 숨김으로 처리한다.
  MEDIA_HIDE
  MEDIA_UNHIDE
}

model User {
  id           String @id @default(cuid())
  loginId      String @unique
  passwordHash String

  /// PII
  name String

  /// PII
  email String @unique

  /// PII
  phone String

  role        UserRole      @default(MEMBER)
  status      AccountStatus @default(ACTIVE)
  withdrawnAt DateTime?

  sessions    AuthSession[]
  resetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, status])
}

model AuthSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 토큰 원문은 저장하지 않고 SHA-256 해시만 저장한다.
  tokenHash String       @unique
  scope     SessionScope
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, scope])
  @@index([expiresAt])
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 토큰 원문은 저장하지 않고 SHA-256 해시만 저장한다. 1회용이다.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// 로그인 시도 제한을 재시작 후에도 유지하기 위한 기록.
/// 식별자 원문은 저장하지 않고 해시만 저장한다. (BLUEPRINT 10장)
model LoginAttempt {
  id             String       @id @default(cuid())
  identifierHash String
  scope          SessionScope
  succeeded      Boolean
  attemptedAt    DateTime     @default(now())

  @@index([identifierHash, attemptedAt])
}

model Campus {
  id      String   @id @default(cuid())
  name    String   @unique
  courses Course[]
  events  Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id       String @id @default(cuid())
  campusId String
  campus   Campus @relation(fields: [campusId], references: [id])

  title        String
  sectionTitle String?
  gradeTitle   String?
  scheduleText String?
  startDate    DateTime?
  displayOrder Int       @default(0)

  /// 관리자가 직접 바꾸는 접수 상태. 정원으로 자동 마감하지 않는다. (ASM-001, Q-ADM-05)
  intakeStatus IntakeStatus @default(OPEN)

  applications CourseApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campusId, displayOrder])
}

model CourseApplication {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  /// PII
  studentName String

  /// PII
  guardianPhone String

  /// PII
  schoolName String

  department String
  grade      String

  privacyConsentAt       DateTime
  retentionPolicyVersion String

  /// PII 파기 대상 시각; 종강·등록 안내 완료 시 관리자가 설정한다. // ASM-009
  purgeEligibleAt DateTime?

  /// 비식별화(파기)를 실행한 시각.
  purgedAt DateTime?

  status      ApplicationStatus @default(PENDING)
  cancelledAt DateTime?

  /// 같은 신청서의 재전송만 막는 유일 키. 같은 연락처의 재신청은 허용한다. (ASM-001)
  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guardianPhone, createdAt])
  @@index([courseId, status])
  @@index([purgeEligibleAt, purgedAt])
  @@index([createdAt])
}

model EventStatusOption {
  id        String @id @default(cuid())
  label     String @unique
  sortOrder Int    @default(0)

  /// true면 새 예약을 받지 않는다.
  isClosed Boolean @default(false)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Event {
  id       String  @id @default(cuid())
  campusId String?
  campus   Campus? @relation(fields: [campusId], references: [id])

  /// 자동 생성하되 관리자가 고칠 수 있다. (ASM-005)
  managementCode String @unique

  title    String
  startsAt DateTime
  venue    String?
  speaker  String?

  statusOptionId String
  statusOption   EventStatusOption @relation(fields: [statusOptionId], references: [id])

  reservations EventReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campusId, startsAt])
  @@index([statusOptionId])
}

model EventReservation {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  /// PII
  name String

  /// PII
  phone String

  grade String

  /// 1건 최대 2명. 상한 검증은 공유 계약(Zod)에서 한다. (ASM-001, D9)
  attendeeCount Int

  privacyConsentAt       DateTime
  retentionPolicyVersion String

  /// PII 파기 대상 시각; 설명회 종료·안내 완료 시 관리자가 설정한다. // ASM-009
  purgeEligibleAt DateTime?

  /// 비식별화(파기)를 실행한 시각.
  purgedAt DateTime?

  status      ReservationStatus @default(PENDING)
  cancelledAt DateTime?

  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone, createdAt])
  @@index([eventId, status])
  @@index([purgeEligibleAt, purgedAt])
  @@index([createdAt])
}

model Instructor {
  id          String  @id @default(cuid())
  name        String
  profileCode String  @unique
  bio         String?

  /// AD-015 강사 사진. 보관함의 이미지를 가리킨다. 비면 공개 화면이 기본 이미지를 쓴다.
  photoMediaId String?
  photoMedia   MediaAsset? @relation("InstructorPhoto", fields: [photoMediaId], references: [id], onDelete: Restrict)

  memberships InstructorTeamMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstructorTeam {
  id   String @id @default(cuid())
  name String @unique

  memberships InstructorTeamMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 한 강사가 여러 팀에 속할 수 있고 팀마다 노출 순서를 따로 둔다. (ASM-003)
model InstructorTeamMembership {
  instructorId String
  teamId       String
  instructor   Instructor     @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  team         InstructorTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([instructorId, teamId])
  @@index([teamId, displayOrder])
}

model Notice {
  id          String                  @id @default(cuid())
  /// Legacy Gnuboard `wr_id`; native posts are null. Used for idempotent import and 308 compatibility.
  legacyWrId  Int?                    @unique
  title       String
  /// Sanitized allow-list HTML only.
  body        String
  isPinned    Boolean                 @default(false)
  status      NoticePublicationStatus @default(DRAFT)
  publishedAt DateTime?

  attachments NoticeAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPinned, publishedAt])
}

model NoticeAttachment {
  id          String   @id @default(cuid())
  noticeId    String
  notice      Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  storageKey  String   @unique
  filename    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([noticeId])
}

/// Administrator-managed consultation-type labels. Defaults are seeded.
model ConsultationTypeOption {
  id           String                    @id @default(cuid())
  label        String                    @unique
  sortOrder    Int                       @default(0)
  isActive     Boolean                   @default(true)
  applications ConsultationApplication[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

model ConsultationApplication {
  id                     String                 @id @default(cuid())
  /// PII
  guardianName           String
  /// PII
  guardianPhone          String
  studentGrade           String
  consultationTypeId     String
  consultationType       ConsultationTypeOption @relation(fields: [consultationTypeId], references: [id])
  /// PII
  inquiry                String?
  privacyConsentAt       DateTime
  retentionPolicyVersion String
  purgeEligibleAt        DateTime?
  purgedAt               DateTime?
  status                 ConsultationStatus     @default(PENDING)
  idempotencyKey         String                 @unique
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([guardianName, createdAt])
  @@index([guardianPhone, createdAt])
  @@index([status, createdAt])
  @@index([purgeEligibleAt, purgedAt])
}

/// Administrator-managed instructor-application status labels. Defaults are seeded.
model InstructorApplicationStatusOption {
  id        String   @id @default(cuid())
  label     String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstructorApplication {
  id                     String    @id @default(cuid())
  /// PII
  name                   String
  /// PII
  phone                  String
  /// PII
  email                  String
  /// PII
  education              String
  experienceYears        String
  specialties            String[]
  capabilities           String[]
  /// PII
  headline               String?
  /// PII
  careerDetail           String?
  /// PII
  coachingDetail         String?
  resumeStorageKey       String    @unique
  resumeFilename         String
  resumeContentType      String
  resumeSizeBytes        Int
  /// EV-0014의 선택 첨부 `교재·기출 해제안`. 없으면 전부 null이다.
  portfolioStorageKey    String?   @unique
  portfolioFilename      String?
  portfolioContentType   String?
  portfolioSizeBytes     Int?
  privacyConsentAt       DateTime
  retentionPolicyVersion String
  purgeEligibleAt        DateTime?
  purgedAt               DateTime?
  /// Label is intentionally a string: the administrator can alter status options.
  status                 String    @default("접수")
  idempotencyKey         String    @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([name, createdAt])
  @@index([status, createdAt])
  @@index([purgeEligibleAt, purgedAt])
}

/// AD-010 설명회 알림 신청. 레거시 메인 하단 폼(`POST ./sms_subscribe.ajax.php`)을 대체한다.
/// 문자 발송은 하지 않는다. 신청 내역만 보관한다. (사용자 결정 2026-11-12, D4)
model SmsSubscription {
  id String @id @default(cuid())

  grade String

  /// PII
  studentName String

  /// PII
  schoolName String

  /// PII
  guardianPhone String

  privacyConsentAt       DateTime
  /// 알림 수신 동의는 개인정보 동의와 따로 받는다. 둘 다 필수다.
  notifyConsentAt        DateTime
  retentionPolicyVersion String

  /// PII 파기 대상 시각. // ASM-009
  purgeEligibleAt DateTime?
  purgedAt        DateTime?

  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guardianPhone, createdAt])
  @@index([createdAt])
  @@index([purgeEligibleAt, purgedAt])
}

/// 보존 설정은 한 행만 쓴다. 표시 문구와 파기 기준이 같은 값을 쓴다. (ASM-009, BZ-002)
model PrivacyRetentionSetting {
  id                    Int    @id @default(1)
  courseRetentionPolicy String
  eventRetentionPolicy  String

  /// Phase 5에서 추가된 신청 종류. 화면 문구와 파기 기준이 같은 값을 쓴다. (BZ-002)
  consultationRetentionPolicy String @default("")
  instructorRetentionPolicy   String @default("")
  smsRetentionPolicy          String @default("")

  /// 자동 파기 기본값은 꺼짐이다.
  automaticPurgeEnabled Boolean @default(false)

  updatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(cuid())

  /// 행위자 식별자. 신청자 개인정보는 넣지 않는다.
  actorUserId String?

  action       AuditAction
  resourceType String
  resourceId   String?

  /// PII 금지: 건수와 필터 이름만 담는 비식별 요약. (AD-013)
  filterSummary String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
}

model AppSetting {
  key   String @id
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 * AD-015 이미지 관리 (관리자 업로드 · 이미지 보관함 · 화면 연결)
 * 설계 근거: docs/decisions/ADR-008-admin-media-upload.md
 * ------------------------------------------------------------------ */

/// 보관함에 들어온 경로.
enum MediaSource {
  /// 관리자가 올린 파일. StorageAdapter 공개 영역에 있다.
  UPLOAD
  /// 레거시에서 받아 `public/images/` 에 커밋한 파일. 저장소에는 없다.
  LEGACY
}

/// 이미지 보관함 1건. 공개 화면이 쓰는 이미지는 모두 여기에 등록된다.
/// 개인정보는 담지 않는다. 신청 서류(이력서)는 비공개 영역이라 여기에 들어오지 않는다.
model MediaAsset {
  id String @id @default(cuid())

  source MediaSource @default(UPLOAD)

  /// `UPLOAD` 는 StorageAdapter 공개 영역 키. `LEGACY` 는 저장소에 없으므로 null 이다.
  storageKey String? @unique

  /// 화면이 쓰는 주소. `LEGACY` 는 `/images/...`, `UPLOAD` 는 어댑터가 준 주소다.
  url String @unique

  /// 올린 사람이 고른 원래 파일 이름. 표시용이고 저장 키에는 쓰지 않는다.
  filename String

  /// 대체 텍스트. 비워 둘 수 없다. 장식용 이미지는 화면 쪽에서 빈 alt 로 바꿔 쓴다.
  alt String

  contentType String
  sizeBytes   Int
  width       Int
  height      Int

  /// 같은 파일을 두 번 올렸는지 알려 주는 용도. 내용 자체는 저장하지 않는다.
  contentHash String?

  /// 레거시 자산의 권리 표시(`docs/legacy/legacy-assets.json`).
  rightsNote String?

  /// 권리 출처가 레거시 학원 자산이 아니어서 교체를 권하는 사진(Unsplash 표시).
  replaceRecommended Boolean @default(false)

  /// 올린 관리자. 레거시 등록본은 null 이다.
  uploadedByUserId String?

  /// 보관함에서 숨긴 시각. 숨긴 사진은 목록·고르기 상자에서 빠지고 새로 붙일 수 없다.
  /// 기존 사이트 사진(`LEGACY`)은 파일이 저장소 바깥(`public/`)에 커밋돼 있어
  /// 실행 중에 지울 수 없으므로 숨기기로 처리한다. (AD-015)
  hiddenAt DateTime?

  /// 숨긴 관리자.
  hiddenByUserId String?

  instructorPhotos Instructor[]    @relation("InstructorPhoto")
  homeBanners      HomeBanner[]
  facilityPhotos   FacilityPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source, createdAt])
  @@index([createdAt])
  @@index([hiddenAt])
}

/// PG-001 메인 배너 슬라이드. 지금 코드에 박혀 있던 3장을 초기 데이터로 넣는다.
/// 행이 하나도 없거나 DB를 읽지 못하면 화면은 코드 기본값으로 그린다. (AD-015 복원력)
model HomeBanner {
  id String @id @default(cuid())

  /// 배경 사진. 비어 있으면 화면이 단색 배경으로 그린다.
  mediaId String?
  media   MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  eyebrow  String @default("")
  headline String
  body     String @default("")

  /// 버튼 문구와 링크. 둘 중 하나가 비면 버튼을 그리지 않는다.
  primaryLabel String?
  primaryHref  String?
  secondaryLabel String?
  secondaryHref  String?

  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVisible, displayOrder])
}

/// PG-004 시설안내 지점별 사진. 지금 커밋돼 있는 8장을 초기 데이터로 넣는다.
model FacilityPhoto {
  id String @id @default(cuid())

  /// `src/lib/site-config.ts` 의 지점 식별자(`daechi` | `bundang`).
  campusKey String

  mediaId String
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  /// 사진 설명. 레거시처럼 비어 있으면 장식용으로 본다.
  caption String @default("")

  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campusKey, isVisible, displayOrder])
}
